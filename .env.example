# Copy this file to `.env` and fill in ONE key. `.env` is git-ignored.

# Which provider to use: groq | github | gemini | openai
LLM_PROVIDER=groq

GROQ_API_KEY=
GITHUB_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: override the default models for the chosen provider.
# The generator writes and revises the lesson; the judge grades it.
# GENERATOR_MODEL=
# JUDGE_MODEL=
